{
  "name": "as-covers",
  "version": "0.1.2",
  "description": "Code coverage transform for AssemblyScript",
  "main": "index.js",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run build:src && npm run run:test-types && npm run run:test-registry && npm run run:test-report && npm run build:test && npm run run:test && npm run run:test-fixtures",
    "test:fixtures": "npm run build:src && npm run run:test-fixtures",
    "test:package": "node tests/package-smoke.js",
    "test:update-snapshots": "npm run build:src && npm run build:test && npm run run:test-update-snapshots",
    "release:check": "npm run test && npm run test:package",
    "build:src": "npm run tsc --workspace @as-covers/glue && npm run tsc --workspace @as-covers/transform",
    "build:test": "asc ./tests/test.ts --lib packages/assembly/index.ts --transform ./packages/transform/lib/index.js --textFile ./tests/output/output.wat --outFile ./tests/output/output.wasm --exportStart _start",
    "run:test": "node --enable-source-maps tests/test",
    "run:test-types": "tsc --noEmit --target ESNext --module ESNext --moduleResolution node --strict --skipLibCheck tests/types-smoke.ts",
    "run:test-registry": "node --enable-source-maps tests/registry.js",
    "run:test-report": "node --enable-source-maps tests/report-formats.js",
    "run:test-fixtures": "node --enable-source-maps tests/coverage-fixtures.js",
    "run:test-update-snapshots": "node --enable-source-maps tests/test --create"
  },
  "author": "Joshua Tenner <tenner.joshua@gmail.com>",
  "contributors": [
    "Jairus Tanaka <jairus.v.tanaka@outlook.com>"
  ],
  "license": "MIT",
  "devDependencies": {
    "@assemblyscript/loader": "^0.25.0",
    "assemblyscript": "^0.25.0",
    "typescript": "^4.9.4"
  }
}
